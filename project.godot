; Engine configuration file.
config_version=5

[application]

config/name="Wildbound"
config/description="A Gen 3 style creature RPG with local co-op."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[autoload]

DB="*res://scripts/autoload/db.gd"
Game="*res://scripts/autoload/game.gd"

[display]

window/size/viewport_width=240
window/size/viewport_height=160
window/size/window_width_override=720
window/size/window_height_override=480
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

theme/custom_font="res://assets/fonts/PressStart2P.ttf"

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.07, 0.07, 0.09, 1)
